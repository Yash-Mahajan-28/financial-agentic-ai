# ==============================================================================
# FinAgentic AI - Personal Finance Agent Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Security Secrets
# Change SESSION_SECRET to a secure 32+ character random string in production
SESSION_SECRET=financial-agentic-ai-super-secret-key-32-chars-long
DEMO_PASSWORD=Demo@1234

# PostgreSQL Database (Used in Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance

# SQLite Fallback (Auto-enabled for instant zero-dependency local runs)
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/finance.db

# Redis & Celery (Task Queue & Scheduled Heartbeat)
REDIS_URL=redis://localhost:6379/0

# Storage & Rule Engine
UPLOAD_DIR=./data/uploads
RULES_PATH=./app/rules/finance_rules.json
MODEL_PATH=./app/ml/category_model.pkl

# ==============================================================================
# AI & Agentic LLM Advisor Configuration
# ==============================================================================

# Option A: Google Gemini API (Recommended for Cloud Demonstration)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option B: Local LLM Endpoint (For 100% Air-Gapped Fintech Data Privacy)
# If using Ollama, run: `ollama run llama3.2` and set:
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3.2
